# ---------------------------------------------------------------------------
# Web app and server
# ---------------------------------------------------------------------------

# Live accounts and one budget database per user. NEVER commit these: they hold
# password hashes and everyone's private data.
server/data/
*.db-wal
*.db-shm

# Built packages, so the repo stays source-only. Attach these to a release
# instead if you want to share them.
*.apk
*.aab
BudgetPlanner-Web.zip

# Node
node_modules/
npm-debug.log*
